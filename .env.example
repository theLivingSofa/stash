# Stash environment variables. Copy to .env.local for local work; `npm run setup`
# writes most of these for you and pushes the runtime ones to Vercel.
# Everything here is free-tier.

# ---- Supabase (database) ----------------------------------------------------
# Personal access token, used only by setup/migration scripts (never deployed).
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Filled in by `npm run setup`:
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only secret key (sb_secret_...). Bypasses RLS; never sent to the browser.
SUPABASE_SECRET_KEY=
# Only set when setup created the project (not needed at runtime).
SUPABASE_DB_PASSWORD=

# ---- App secrets (generated by `npm run setup`) ----------------------------
# The passcode you type to unlock the app.
APP_PASSCODE=
# Bearer token GitHub Actions uses to call /api/ingest.
INGEST_SECRET=
# Signs the session cookie and feed cursors (32+ random chars).
SESSION_SECRET=
# Public URL of the deployment (setup fills this in). Also used for the
# Google redirect URI and links in emails.
SITE_URL=

# ---- Sign-in and sharing ---------------------------------------------------
# Your Google email. This account is the owner (gets /admin; passcode logs in as it).
OWNER_EMAIL=
# Google OAuth client (free): https://console.cloud.google.com/auth/clients
# Web application; redirect URIs: <SITE_URL>/api/auth/google/callback and
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend (free, no domain needed): https://resend.com/api-keys. Sign up with
# OWNER_EMAIL: the free sender can only email the account owner, which is
# where access requests go.
RESEND_API_KEY=

# ---- Natural read-aloud (optional; free tiers, never bills) ----------------
# Azure AI Speech, Free F0 tier (Azure for Students needs no card):
# portal.azure.com > Create a resource > Speech > Pricing tier "Free F0".
# Keys and Endpoint page: KEY 1 and Location/Region (e.g. centralindia).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Backblaze B2 (10 GB free, no card) keeps each card's audio so it's made once.
# Private bucket + an application key limited to it (Read and Write).
# Set every cap under Caps & Alerts to $0.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
# The bucket's S3 endpoint, e.g. s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
# Monthly character allowance (default 450000, below Azure's free 500000).
# TTS_MONTHLY_CHARS=450000

# ---- LLM providers (free tiers). Comma-separate several keys to rotate. ----
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEYS=
# Groq: https://console.groq.com/keys
GROQ_API_KEYS=
# OpenRouter (free ":free" models only): https://openrouter.ai/settings/keys
OPENROUTER_API_KEYS=
# Optional. Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEYS=
# Optional. Mistral "Experiment" (free) plan: https://console.mistral.ai/api-keys
MISTRAL_API_KEYS=

# ---- Optional model overrides (no redeploy of code needed) -----------------
# Comma-separated, first = preferred. Defaults live in src/lib/llm/config.ts.
# LLM_MODELS_GEMINI=gemini-3.5-flash,gemini-2.5-flash
# LLM_MODELS_GROQ=openai/gpt-oss-120b
# LLM_MODELS_CEREBRAS=gpt-oss-120b
# LLM_MODELS_OPENROUTER=minimax/minimax-m3.1-flash:free
# LLM_MODELS_MISTRAL=mistral-small-latest
