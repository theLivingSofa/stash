# Stash environment variables. Copy to .env.local for local work; `npm run setup`
# writes most of these for you and pushes the runtime ones to Vercel.
# Everything here is free-tier.

# ---- Supabase (database) ----------------------------------------------------
# Personal access token, used only by setup/migration scripts (never deployed).
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Filled in by `npm run setup`:
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only secret key (sb_secret_...). Bypasses RLS; never sent to the browser.
SUPABASE_SECRET_KEY=
# Only set when setup created the project (not needed at runtime).
SUPABASE_DB_PASSWORD=

# ---- App secrets (generated by `npm run setup`) ----------------------------
# The passcode you type to unlock the app.
APP_PASSCODE=
# Bearer token GitHub Actions uses to call /api/ingest.
INGEST_SECRET=
# Signs the session cookie and feed cursors (32+ random chars).
SESSION_SECRET=
# Public URL of the deployment (setup fills this in).
SITE_URL=

# ---- LLM providers (free tiers). Comma-separate several keys to rotate. ----
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEYS=
# Groq: https://console.groq.com/keys
GROQ_API_KEYS=
# OpenRouter (free ":free" models only): https://openrouter.ai/settings/keys
OPENROUTER_API_KEYS=
# Optional. Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEYS=
# Optional. Mistral "Experiment" (free) plan: https://console.mistral.ai/api-keys
MISTRAL_API_KEYS=

# ---- Optional model overrides (no redeploy of code needed) -----------------
# Comma-separated, first = preferred. Defaults live in src/lib/llm/config.ts.
# LLM_MODELS_GEMINI=gemini-3.5-flash,gemini-2.5-flash
# LLM_MODELS_GROQ=openai/gpt-oss-120b
# LLM_MODELS_CEREBRAS=gpt-oss-120b
# LLM_MODELS_OPENROUTER=minimax/minimax-m3.1-flash:free
# LLM_MODELS_MISTRAL=mistral-small-latest
