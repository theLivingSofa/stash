{
  "name": "stash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "setup": "tsx --conditions=react-server scripts/setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "ingest:local": "tsx --conditions=react-server scripts/ingest-once.ts",
    "sources:check": "tsx --conditions=react-server scripts/check-sources.ts",
    "llm:check": "tsx --conditions=react-server scripts/llm-check.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "teardown": "tsx scripts/teardown.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-virtual": "^3.14.21",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.13",
    "linkedom": "^0.18.14",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9"
  }
}
